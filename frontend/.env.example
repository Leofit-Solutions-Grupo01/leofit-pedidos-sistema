# Frontend Environment Variables Template
# Copy this file to .env or .env.local and NEVER commit real keys to Git.

# URL of the Backend API REST (e.g., https://leofit-api.onrender.com/api or http://localhost:3000/api)
VITE_API_URL=http://localhost:3000/api

# App Environment (development / production)
VITE_APP_ENV=development

# Feature Flags
# Set to 'true' to use the local UI mock login (admin@leofit.com / admin123) when backend is offline.
VITE_USE_MOCK_AUTH=false
