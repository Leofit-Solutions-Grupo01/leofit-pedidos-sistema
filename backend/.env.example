# =============================================================================
# CONFIGURACIÓN DEL ENTORNO - LEOFIT BACKEND API
# =============================================================================
PORT=4000
NODE_ENV=development

# Seguridad & Autenticación JWT
JWT_SECRET=leofit_super_secret_jwt_key_academic_2026_production_ready
JWT_EXPIRES_IN=24h
BCRYPT_SALT_ROUNDS=10

# Base de Datos PostgreSQL / Supabase
# Si DATABASE_URL está definida, se conectará a PostgreSQL; si no, usará el almacén transaccional en memoria de respaldo.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/leofit_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=leofit_db
DB_SSL=false

# Políticas de CORS y Seguridad
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
