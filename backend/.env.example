# Backend Environment Variables Template
# Copy this file to .env and NEVER commit real keys or credentials to Git.

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Connection (MySQL / PostgreSQL)
# Example: mysql://usuario:password@localhost:3306/leofit_db
# Example PostgreSQL: postgresql://postgres:password@localhost:5432/leofit_db?schema=public
DATABASE_URL=mysql://root:password@localhost:3306/leofit_db

# Security & JWT Authentication
# Generate a strong 64-char secret: openssl rand -base64 48
JWT_SECRET=super_secret_jwt_key_change_me_in_production
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (Frontend URL)
# Example: http://localhost:5173 or https://leofit-solutions-grupo01.github.io
CLIENT_ORIGIN=http://localhost:5173
