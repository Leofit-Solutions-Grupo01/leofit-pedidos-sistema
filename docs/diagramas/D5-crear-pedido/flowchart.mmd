flowchart TD
    Start([Inicio create]) --> Begin[BEGIN ISOLATION LEVEL READ COMMITTED]
    Begin --> SelectForUpdate[SELECT stock FROM products FOR UPDATE]
    SelectForUpdate --> CheckStock{¿Hay stock<br/>disponible?}
    
    CheckStock -->|No| Rollback[ROLLBACK]
    Rollback --> Throw[throw error]
    
    CheckStock -->|Sí| InsertOrder[INSERT INTO orders]
    InsertOrder --> InsertItems[INSERT INTO order_items]
    InsertItems --> UpdateStock[UPDATE products SET stock = stock - N]
    UpdateStock --> CommitDB[COMMIT]
    CommitDB --> Return[return Order]
