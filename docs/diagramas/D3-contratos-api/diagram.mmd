classDiagram
    %% Modelos Core de Negocio y DTOs
    class CreateOrderDTO {
        +number? clientId
        +Object? clientData
        +number? userId
        +PaymentMethod paymentMethod
        +number shippingCost
        +string? notes
        +Array items
    }

    class Order {
        +number id
        +string order_number
        +number client_id
        +OrderStatus status
        +number subtotal
        +number shipping_cost
        +number total_amount
        +PaymentMethod payment_method
        +Date created_at
    }

    class OrderItem {
        +number variant_id
        +number quantity
        +number unit_price
        +number subtotal
    }

    class Client {
        +number id
        +string full_name
        +string phone
        +string address
        +string district
    }
    
    class ClientDTO {
        +string full_name
        +string phone
        +string address
        +string district
        +string? reference
    }

    class Product {
        +number id
        +number category_id
        +string name
        +string description
        +number base_price
        +string image_url
        +boolean is_active
        +Date created_at
    }

    class ProductDTO {
        +number categoryId
        +string name
        +string? description
        +number basePrice
        +string? imageUrl
        +boolean isActive
        +Array variants
    }

    class PaymentWebhookPayload {
        +string provider
        +string transactionId
        +string orderCode
        +number amount
        +string status
    }

    class DashboardMetrics {
        +number totalOrders
        +Record ordersByStatus
        +number totalRevenue
        +number lowStockCount
        +Array recentOrders
        +Array topSellingProducts
    }

    class ActivityRecord {
        +number id
        +number order_id
        +number? user_id
        +OrderStatus? previous_status
        +OrderStatus new_status
        +Date changed_at
        +string? comments
        +string order_number
        +string client_name
        +string user_name
    }

    CreateOrderDTO --> Order : Genera >
    Order "1" *-- "1..*" OrderItem : Contiene
    Order "1" --> "1" Client : Pertenece a
    ProductDTO --> Product : Genera >
    ClientDTO --> Client : Genera >
